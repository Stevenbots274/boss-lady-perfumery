RewriteEngine On

# All sessions and customer data must travel over HTTPS.
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [R=301,L]

Options -Indexes
<FilesMatch "^(config|db)\.php$|^(schema|migration-security|README)\.(sql|md)$">
    Require all denied
</FilesMatch>
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

RewriteRule ^order/([a-fA-F0-9]{64})/?$ order.php?token=$1 [L]
